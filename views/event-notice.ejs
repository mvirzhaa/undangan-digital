<!DOCTYPE html>
<html lang="id">
<head>
  <title><%= title %> — <%= inv.title %></title>
  <%- include('partials/ev-head', { fontsUrl }) %>
</head>
<body class="ev" style="<%= cssVars %>">
<main class="ev-wrap">
  <header class="ev-head"><small><%= inv.title %></small><h1><%= title %></h1></header>
  <section class="card center">
    <p><%= text %></p>
    <% if (link) { %><p><a class="btn primary" href="<%= link.href %>"><%= link.label %></a></p><% } %>
  </section>
  <p class="ev-foot"><a href="<%= basePath %>/<%= inv.slug %>">← Kembali ke undangan</a></p>
</main>
</body>
</html>
